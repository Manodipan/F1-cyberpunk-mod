# Binary game assets: only the Phoenix archive is tracked (it IS the deliverable).
# Everything else binary stays out of Git.
*.archive
!Phoenix_aston_cheats/archive/pc/mod/phoenix_aston_valkyrie.archive
*.archive.xl
!Phoenix_aston_cheats/archive/pc/mod/phoenix_aston_valkyrie.archive.xl
# packed onscreens archive (docs/WOLVENKIT.md) - optional, 8 KB, ships when built
!Phoenix_aston_cheats/archive/pc/mod/phoenix_strings.archive
*.bnk

# Local tooling noise
__pycache__/
*.pyc
.venv/

# Nexus/Vortex upload artefacts
dist/

# Reference corpus (tools/collect_vehicles.py): the raw YAMLs are other authors' work and
# are NOT redistributed here - they stay on the machine that ran the collector. The
# generated facts (INDEX.md) are tracked, and that is what we actually compare against.
reference/vehicles/**/*.yaml
# ...except the one car we explicitly asked for (572 km/h reference)
!reference/vehicles/jesko_attack.yaml
