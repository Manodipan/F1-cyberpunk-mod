<?xml version="1.0"?>

<bindings>
    <context name="VehicleAutoDriveEnhanced">
        <action name="VehADESwitchSeats" map="VehADESwitchSeats_Button" />
        <action name="VehADESwitchAI" map="VehADESwitchAI_Button" />
    </context>

    <mapping name="VehADESwitchSeats_Button" type="Button">
        <button id="IK_V" overridableUI="ADE_SwitchSeats_Key" />
        <button id="IK_Pad_ADE_SwitchSeats" />
    </mapping>

    <buttonGroup id="IK_Pad_ADE_SwitchSeats" timeWindow="0.08f">
        <button id="IK_Pad_X_SQUARE" />
        <button id="IK_Pad_A_CROSS" />
    </buttonGroup>

    <mapping name="VehADESwitchAI_Button" type="Button">
        <button id="IK_T" overridableUI="ADE_SwitchAI_Key" />
        <button id="IK_Pad_ADE_SwitchAI" />
    </mapping>

    <buttonGroup id="IK_Pad_ADE_SwitchAI" timeWindow="0.08f">
        <!-- Jump out とコンフリクト -->
        <!-- <button id="IK_Pad_B_CIRCLE" /> -->
        <button id="IK_Pad_Y_TRIANGLE" />
        <button id="IK_Pad_X_SQUARE" />
    </buttonGroup>

    <context name="VehicleAutodriveMountedWeapons" >
		<include name="CameraMovement" />
		<include name="VisionActions" />
		<include name="UIExploration" />
		<include name="PhotoMode" />
		<include name="QuickLoadAndSave" />
		<include name="VehicleAuxillary" />

		<action name="Accelerate"			map="Acceleration_Axis" />
		<action name="Decelerate"			map="Deceleration_Axis" />
		<action name="TurnX"				map="LeftX_Axis_Vehicle" />
		<action name="LeanFB"				map="LeftY_Axis_Vehicle" />
		<action name="RockFB"				map="LeftY_Axis_Vehicle_RockFB" />
		<action name="ToggleVehCamera"		map="VehicleCameraToggle" />
		<action name="VehicleInverseCameraToggle"	map="VehicleInverseCameraToggle_Button"/>
        <action name="VehicleCameraReset"	map="VehicleCameraReset_Button"/>
		<action name="Exit"					map="ExitVehicle_Button" />
		<action name="QuickExit"			map="ExitVehicle_Button"  />
		<action name="CycleLights"			map="Vehicle_CycleLights" />
		<action name="ZoomIn"				map="ZoomIn_Button"/>
		<action name="ZoomOut"				map="ZoomOut_Button"/>
		<action name="VehicleHorn" 			map="Vehicle_Horn" />
		<action name="EnterCombatMode"		map="SwitchItem_Button" />
		<action name="HoldAutodrive"      	map="Vehicle_Autodrive" />
        <!-- <include name="Items" /> -->

		<action name="ToggleAutodrive"      map="Vehicle_Autodrive" />
		<action name="HoldCinematicCamera"	map="VehicleCameraToggle" />
	</context>

    <context name="BaseVehicleDriverCombat" append="true">
        <action name="HoldAutodrive" map="Vehicle_Autodrive" />
    </context>

    <context name="VehicleDriveBase" append="true">
        <include name="VehicleAutoDriveEnhanced" />
    </context>

    <context name="BaseVehicleAutodrive" append="true">
        <action name="VehicleCameraReset"	map="VehicleCameraReset_Button"/>
    </context>

    <context name="VehicleAutodrive" append="true">
        <include name="VehicleAutoDriveEnhanced" />

        <action name="IconicCyberware"	  	map="IconicCyberware_Button" />
		<action name="UseConsumable"		map="UseConsumable_Button" />
    </context>

    <context name="VehicleMountedWeaponsAutodrive" append="true">
        <include name="VehicleAutoDriveEnhanced" />
        
        <action name="IconicCyberware"	  	map="IconicCyberware_Button" />
		<action name="UseConsumable"		map="UseConsumable_Button" />

        <!-- For MountedWeapons -->
        <action name="MountedWeapons_WeaponSlot1"			map="Vehicle_MountedWeapons_WeaponSlot1_Button" />
		<action name="MountedWeapons_WeaponSlot2"			map="Vehicle_MountedWeapons_WeaponSlot2_Button" />
		<action name="MountedWeapons_SwitchWeapons"			map="Vehicle_MountedWeapons_SwitchWeapons_Button" />
		<action name="MountedWeapons_HolsterWeapon"			map="Vehicle_MountedWeapons_HolsterWeapon_Button" />
		<action name="MountedWeapons_NextWeapon"			map="Vehicle_MountedWeapons_NextWeapon_Button" />
		<action name="MountedWeapons_PreviousWeapon"		map="Vehicle_MountedWeapons_PreviousWeapon_Button" />
    </context>

    <context name="VehiclePassenger" append="true">
        <include name="VehicleAutoDriveEnhanced" />
        <action name="HoldAutodrive" map="Vehicle_Autodrive" />
        <action name="VehicleCameraReset"	map="VehicleCameraReset_Button"/>

        <!-- radio -->
        <action name="VehicleInsideWheel" map="VehicleInsideWheel_Button"/>
        <!-- cyberware(sandevistan etc) -->
        <action name="IconicCyberware" map="IconicCyberware_Button" />
    </context>
    
    <context name="VehicleAutodrivePassenger">
        <include name="VehiclePassenger" />
        
        <action name="ToggleAutodrive"      map="Vehicle_Autodrive" />
		<action name="HoldCinematicCamera"	map="VehicleCameraToggle" />
    </context>
</bindings>
